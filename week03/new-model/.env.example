# Copy to .env and fill in. Used by the `chat` service (env_file in docker-compose.yml).
# Everything else (DATABASE_URL, MINIO_*) is set inline in docker-compose.yml.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional — compose already sets these; override here only if needed.
# CLAUDE_MODEL=claude-sonnet-5
# DOCUMENT_API_URL=http://document-api:8000
